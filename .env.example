# ── PocketDesk configuration ────────────────────────────────────────────
# Copy to .env (setup.sh does this for you and fills in the secrets).

# Exactly 32 characters. Encrypts the per-session connection tokens.
# Generate with: openssl rand -hex 16
SECRET_KEY=

# PIN/password you type on the phone to open a session. Required.
WEB_PIN=

# Where guacd finds your RDP server. host.docker.internal = this VM itself
# (the usual case: xrdp running on the same Oracle VM).
RDP_HOST=host.docker.internal
RDP_PORT=3389

# VM login. Leave RDP_PASSWORD empty to type it on the phone each time
# (recommended — then it's never stored on disk).
RDP_USERNAME=ubuntu
RDP_PASSWORD=

# xrdp is happiest with "any" / "rdp". Windows hosts usually want "nla".
RDP_SECURITY=any

# Audio from the VM (adds bandwidth). true/false
RDP_AUDIO=false

# ── HTTPS ────────────────────────────────────────────────────────────────
# Default: serve on port 443 with a self-signed certificate.
SITE_ADDRESS=:443
CADDY_TLS=internal
# With a domain pointed at this VM, use instead:
# SITE_ADDRESS=vm.example.com
# CADDY_TLS=you@example.com
